<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="1920dp"
    android:layout_height="@dimen/dp_720"
    android:paddingStart="623dp"
    android:paddingEnd="@dimen/dp_0">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/ar_car_model_window_fl_in"
        android:elevation="-1dp"/>
    <com.yftech.yfmycar.view.widgets.VerticalAnimWindowTouchView
        android:layout_gravity="end"
        android:id="@+id/verticalWindow"
        android:layout_width="@dimen/dp_571"
        android:layout_height="@dimen/dp_290"
        android:layout_marginTop="303dp"
        android:layout_marginEnd="528dp"
        app:WhichSeat="0"
        app:WindowMoveMax="240"
        app:backgroundViewDrawable="@drawable/status_front_left_window_selector"
        app:touchViewClickable="true"
        app:touchViewDrawable="@drawable/status_front_left_window_selector_touch"/>
    <View
        android:background="@drawable/status_rear_left_window_selector"
        android:layout_width="@dimen/dp_436"
        android:layout_height="@dimen/dp_220"
        android:layout_marginTop="@dimen/dp_304"
        android:layout_marginStart="-305dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/ar_car_model_window_fl_out"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_up_front_left"
        android:background="@drawable/btn_up_selector"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_124"
        android:layout_marginStart="@dimen/dp_512"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_down_front_left"
        android:background="@drawable/btn_down_selector"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_490"
        android:layout_marginStart="@dimen/dp_512"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_28"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:layout_gravity="start|bottom"
        android:id="@+id/one_click_open_window_front_left"
        android:background="@drawable/a79_cb_select_yellow_gray90_big"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_62"
        android:layout_marginBottom="@dimen/dp_43"
        android:text="@string/one_click_open_window"
        android:layout_marginStart="601dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_28"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:layout_gravity="start|bottom"
        android:id="@+id/one_click_close_window_front_left"
        android:background="@drawable/a79_cb_select_yellow_gray90_big"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_62"
        android:layout_marginBottom="@dimen/dp_43"
        android:text="@string/one_click_close_window"
        android:layout_marginStart="@dimen/dp_340"/>
</FrameLayout>
