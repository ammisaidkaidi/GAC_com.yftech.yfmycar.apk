<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@mipmap/mycay_vecl_pic_car_tailgate_bg"
    android:layout_width="1920dp"
    android:layout_height="@dimen/dp_720"
    android:layoutDirection="rtl">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_car"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/ar_car_model_tailgate"/>
    <com.yftech.yfmycar.view.widgets.TailgateOpenView
        android:layout_gravity="end"
        android:id="@+id/tailgate_open_view"
        android:layout_width="928dp"
        android:layout_height="604dp"
        android:scaleX="-1"
        android:layout_marginEnd="272dp"/>
    <com.yftech.yfmycar.view.widgets.TailgateBitmapView
        android:layout_gravity="end"
        android:id="@+id/tailgate_bitmap_view"
        android:layout_width="928dp"
        android:layout_height="604dp"
        android:scaleX="-1"
        android:layout_marginEnd="272dp"/>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/frame_memory_location"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_240"
        android:layout_marginTop="@dimen/dp_100"
        android:layout_marginEnd="946dp">
        <TextView
            android:textSize="@dimen/sp_24"
            android:textColor="@color/color_BE8C18_100"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/tv_memory_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/memory_location"/>
    </FrameLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="end|bottom"
        android:orientation="horizontal"
        android:id="@+id/ll_tailgate_buttons"
        android:layout_width="530dp"
        android:layout_height="62dp"
        android:layout_marginBottom="@dimen/dp_43"
        android:layout_marginEnd="409dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_28"
            android:textColor="@drawable/btn_text_color_transparent90_selector"
            android:gravity="center"
            android:id="@+id/close_tail_door"
            android:background="@drawable/a79_cb_select_yellow_gray90_big"
            android:visibility="visible"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:text="@string/open_tail_door"
            android:layout_marginEnd="43dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_28"
            android:textColor="@drawable/btn_text_color_transparent90_selector"
            android:gravity="center"
            android:id="@+id/clear_memory_position"
            android:background="@drawable/a79_btn_cornor_31_yellow"
            android:visibility="gone"
            android:layout_width="286dp"
            android:layout_height="match_parent"
            android:text="@string/clear_memory_position"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_28"
            android:textColor="@drawable/btn_text_color_transparent90_selector"
            android:gravity="center"
            android:id="@+id/memory_position"
            android:background="@drawable/a79_btn_cornor_31_gray90_trans"
            android:visibility="gone"
            android:layout_width="286dp"
            android:layout_height="match_parent"
            android:text="@string/memorize_current_position"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_28"
            android:textColor="@drawable/btn_text_color_transparent90_selector"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/open_memory_position"
            android:background="@drawable/a79_cb_select_yellow_gray90_big"
            android:visibility="gone"
            android:layout_width="286dp"
            android:layout_height="match_parent"
            android:text="@string/open_memory_position"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
