<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@mipmap/mycar_vecl_btn_sliding_door_bg"
    android:layout_width="@dimen/dp_348"
    android:layout_height="@dimen/dp_92"
    android:elevation="@dimen/dp_1">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_24"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:id="@+id/sliding_door_right_switch_text"
        android:layout_width="@dimen/dp_348"
        android:layout_height="@dimen/dp_92"
        android:text="@string/sliding_open_sliding_door"
        android:includeFontPadding="false"
        android:lineSpacingExtra="-4dp"
        android:paddingStart="@dimen/dp_46"
        android:paddingEnd="@dimen/dp_46"
        android:layout_alignParentEnd="true"
        android:elevation="@dimen/dp_1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_open_close_door_point"
        android:clickable="true"
        android:layout_width="@dimen/dp_92"
        android:layout_height="@dimen/dp_92"
        android:src="@mipmap/mycar_vecl_btn_sliding_door"
        android:layout_alignParentStart="true"
        android:elevation="@dimen/dp_2"/>
</RelativeLayout>
