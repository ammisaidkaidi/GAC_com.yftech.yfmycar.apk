<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rela_main"
    android:background="@mipmap/vent_heat_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RadioGroup
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:id="@+id/radio_group_seat_adjust"
        android:background="@drawable/a79_btn_cornor_28_gray_trans"
        android:visibility="visible"
        android:layout_width="@dimen/dp_506"
        android:layout_height="@dimen/dp_56"
        android:layout_marginTop="@dimen/dp_110"
        android:layout_marginEnd="417dp"
        android:elevation="@dimen/dp_1">
        <RadioButton
            android:textSize="@dimen/sp_28"
            android:textColor="@drawable/btn_text_color_transparent90_selector"
            android:gravity="center"
            android:id="@+id/seat_position_adjust"
            android:background="@drawable/a79_cb_select_yellow_gray"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:checked="true"
            android:button="@null"
            android:text="@string/seat_position_adjust"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:lineSpacingExtra="-4dp"
            android:paddingHorizontal="@dimen/dp_4"/>
        <RadioButton
            android:textSize="@dimen/sp_28"
            android:textColor="@drawable/btn_text_color_transparent90_selector"
            android:gravity="center"
            android:id="@+id/seat_ventilation_heating"
            android:background="@drawable/a79_cb_select_yellow_gray"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/seat_ventilation_heating"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:lineSpacingExtra="-4dp"
            android:paddingStart="@dimen/dp_10"
            android:paddingEnd="@dimen/dp_10"
            android:paddingHorizontal="@dimen/dp_4"/>
    </RadioGroup>
</FrameLayout>
