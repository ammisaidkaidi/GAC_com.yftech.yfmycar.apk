<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="1920dp"
    android:layout_height="@dimen/dp_720"
    android:paddingStart="636dp"
    android:paddingEnd="@dimen/dp_54">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="@dimen/dp_376"
        android:layout_height="@dimen/dp_376"
        android:layout_marginTop="@dimen/dp_210">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|bottom"
            android:id="@+id/cool_hot_level_seat"
            android:layout_width="@dimen/dp_250"
            android:layout_height="@dimen/dp_302"
            android:src="@mipmap/seat_small"
            android:layout_marginStart="@dimen/dp_17"/>
    </FrameLayout>
    <com.yftech.yfmycar.view.widgets.AngleLeftTouchRelativeLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/relative_touch"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_376"
        android:layout_height="@dimen/dp_376"
        android:layout_marginTop="@dimen/dp_210">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cool_hot_level"
            android:layout_width="@dimen/dp_245"
            android:layout_height="@dimen/dp_272"
            android:layout_alignParentEnd="true"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_28"
            android:textColor="@color/white_70"
            android:gravity="center"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_178"
            android:text="1"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="@dimen/dp_46"
            android:layout_alignParentEnd="true"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_28"
            android:textColor="@color/white_70"
            android:gravity="center"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_80"
            android:text="2"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="@dimen/dp_77"
            android:layout_alignParentEnd="true"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_28"
            android:textColor="@color/white_70"
            android:gravity="center"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_29"
            android:text="3"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="@dimen/dp_170"
            android:layout_alignParentEnd="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cool_hot_img"
            android:layout_width="@dimen/dp_83"
            android:layout_height="@dimen/dp_83"
            android:layout_marginTop="@dimen/dp_150"
            android:layout_marginEnd="@dimen/dp_160"
            android:layout_alignParentEnd="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cool_hot_round"
            android:layout_width="@dimen/dp_83"
            android:layout_height="@dimen/dp_83"
            android:layout_marginTop="@dimen/dp_150"
            android:layout_marginEnd="@dimen/dp_160"
            android:layout_alignParentEnd="true"/>
    </com.yftech.yfmycar.view.widgets.AngleLeftTouchRelativeLayout>
    <RadioGroup
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/radio_group_heating"
        android:background="@drawable/a79_btn_cornor_10_1c212b"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_64"
        android:layout_marginBottom="@dimen/dp_40">
        <RadioButton
            android:textSize="@dimen/sp_24"
            android:textColor="@drawable/btn_text_color_transparent90_selector"
            android:gravity="center"
            android:id="@+id/cb_seat_ventilation_heating_intelligence"
            android:background="@drawable/a79_btn_vent_heat"
            android:layout_width="@dimen/dp_140"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/intelligence"/>
        <RadioButton
            android:textSize="@dimen/sp_24"
            android:textColor="@drawable/btn_text_color_transparent90_selector"
            android:gravity="center"
            android:id="@+id/cb_seat_heating"
            android:background="@drawable/a79_btn_vent_heat"
            android:layout_width="@dimen/dp_140"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/heating"/>
        <RadioButton
            android:textSize="@dimen/sp_24"
            android:textColor="@drawable/btn_text_color_transparent90_selector"
            android:gravity="center"
            android:id="@+id/cb_seat_ventilation"
            android:background="@drawable/a79_btn_vent_heat"
            android:layout_width="@dimen/dp_140"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/ventilate"/>
        <RadioButton
            android:textSize="@dimen/sp_24"
            android:textColor="@drawable/btn_text_color_transparent90_selector"
            android:gravity="center"
            android:id="@+id/cb_seat_ventilation_heating_close"
            android:background="@drawable/a79_btn_vent_heat"
            android:layout_width="@dimen/dp_140"
            android:layout_height="match_parent"
            android:checked="true"
            android:button="@null"
            android:text="@string/close"/>
    </RadioGroup>
</FrameLayout>
