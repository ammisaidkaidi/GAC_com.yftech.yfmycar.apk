<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout-ldrtl/activity_main_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@color/color_2a2a2a"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_3"
        android:layout_marginTop="@dimen/dp_77"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_180"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/radio_group"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_80"
        android:paddingStart="@dimen/dp_40"
        android:paddingEnd="@dimen/dp_40">
        <RadioButton
            android:textSize="@dimen/sp_32"
            android:textColor="@drawable/btn_text_color_transparent70_selector"
            android:gravity="center"
            android:id="@+id/open_close_control"
            android:tag="binding_1"
            android:background="@drawable/btn_top_tab_bg_selector"
            android:layout_width="@dimen/dp_240"
            android:layout_height="match_parent"
            android:button="@null"
            android:maxWidth="@dimen/dp_370"
            android:minWidth="@dimen/dp_240"
            android:text="@string/open_close_control"
            android:includeFontPadding="false"
            android:lineSpacingExtra="-8dp"/>
        <RadioButton
            android:textSize="@dimen/sp_32"
            android:textColor="@drawable/btn_text_color_transparent70_selector"
            android:gravity="center"
            android:id="@+id/cockpit"
            android:tag="binding_2"
            android:background="@drawable/btn_top_tab_bg_selector"
            android:layout_width="@dimen/dp_240"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/cockpit"
            android:includeFontPadding="false"
            android:lineSpacingExtra="-8dp"/>
        <RadioButton
            android:textSize="@dimen/sp_32"
            android:textColor="@drawable/btn_text_color_transparent70_selector"
            android:gravity="center"
            android:id="@+id/lighting_effect"
            android:tag="binding_3"
            android:background="@drawable/btn_top_tab_bg_selector"
            android:layout_width="@dimen/dp_240"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/lighting_effect"
            android:includeFontPadding="false"
            android:lineSpacingExtra="-8dp"/>
    </LinearLayout>
    <FrameLayout
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_105"
        android:layout_marginStart="@dimen/dp_40">
        <include
            android:id="@+id/layout_open_close_control"
            layout="@layout/layout_open_close_control"/>
        <include
            android:id="@+id/layout_cockpit"
            layout="@layout/layout_cockpit"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/ll_tip"
        android:tag="binding_5"
        android:background="@color/black_80"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="840dp"
        android:paddingEnd="@dimen/dp_70">
        <TextView
            android:textSize="@dimen/sp_36"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_tip"
            android:background="@mipmap/vecl_btn_popup_bg"
            android:paddingTop="@dimen/dp_50"
            android:paddingBottom="@dimen/dp_75"
            android:layout_width="@dimen/dp_534"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_160"
            android:text="@string/tip_acc_on"
            android:paddingStart="@dimen/dp_50"
            android:paddingEnd="@dimen/dp_50"/>
    </LinearLayout>
</FrameLayout>
