<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/frame_base"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ll_tip"
        android:background="@color/black_80"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="840dp"
        android:paddingEnd="@dimen/dp_70">
        <TextView
            android:textSize="@dimen/sp_36"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_tip"
            android:background="@mipmap/vecl_btn_popup_bg"
            android:paddingTop="@dimen/dp_48"
            android:paddingBottom="@dimen/dp_59"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_160"
            android:text="@string/tip_fault"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"/>
    </LinearLayout>
</FrameLayout>
