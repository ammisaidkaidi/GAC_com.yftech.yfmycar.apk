<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/frame"
    android:background="@color/black_80"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:paddingStart="@dimen/dp_596"
    android:paddingEnd="@dimen/dp_0">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog"
        android:padding="@dimen/dp_20"
        android:layout_width="800dp"
        android:layout_height="350dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dialog_window_reversing_text_size"
            android:textColor="@color/white_90"
            android:gravity="center"
            android:padding="@dimen/dp_38"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:text="@string/tip_window_reversing"/>
        <View
            android:background="@color/color_cedcff_15"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dialog_window_reversing_text_size"
            android:textColor="@color/white_90"
            android:gravity="center"
            android:id="@+id/btn_confirm"
            android:background="@drawable/bg_press_corners_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/sure"/>
    </LinearLayout>
</FrameLayout>
