<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@mipmap/mycar_vecl_pic_car_right_rear_car_in"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="-1dp"/>
    <com.yftech.yfmycar.view.widgets.VerticalAnimWindowTouchView
        android:id="@+id/verticalWindow"
        android:layout_width="@dimen/dp_436"
        android:layout_height="@dimen/dp_270"
        android:layout_marginTop="303dp"
        android:layout_marginEnd="553dp"
        android:layout_alignParentEnd="true"
        android:elevation="-1dp"
        app:WhichSeat="3"
        app:WindowMoveMax="220"
        app:backgroundViewDrawable="@drawable/status_rear_right_window_selector"
        app:touchViewClickable="true"
        app:touchViewDrawable="@drawable/status_rear_right_window_selector_touch"/>
    <View
        android:background="@mipmap/mycar_vecl_pic_car_right_rear_car"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@drawable/status_front_right_window_selector"
        android:layout_width="@dimen/dp_571"
        android:layout_height="@dimen/dp_258"
        android:layout_marginTop="@dimen/dp_304"
        android:layout_marginEnd="-85dp"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_up"
        android:background="@drawable/btn_up_selector"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_124"
        android:layout_marginEnd="@dimen/dp_512"
        android:layout_alignParentEnd="true"
        android:elevation="@dimen/dp_2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_down"
        android:background="@drawable/btn_down_selector"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_490"
        android:layout_marginEnd="@dimen/dp_512"
        android:layout_alignParentEnd="true"
        android:elevation="@dimen/dp_2"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_bottom_buttons"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_62"
        android:layout_marginBottom="@dimen/dp_43"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/dp_340"
        android:layout_alignParentEnd="true">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_28"
            android:textColor="@drawable/btn_text_color_transparent90_selector"
            android:gravity="center"
            android:id="@+id/one_click_open_window"
            android:background="@drawable/a79_cb_select_yellow_gray90_big"
            android:layout_width="@dimen/dp_200"
            android:layout_height="match_parent"
            android:text="@string/one_click_open_window"
            android:layout_marginEnd="@dimen/dp_64"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_28"
            android:textColor="@drawable/btn_text_color_transparent90_selector"
            android:gravity="center"
            android:id="@+id/one_click_close_window"
            android:background="@drawable/a79_cb_select_yellow_gray90_big"
            android:layout_width="@dimen/dp_200"
            android:layout_height="match_parent"
            android:text="@string/one_click_close_window"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>
