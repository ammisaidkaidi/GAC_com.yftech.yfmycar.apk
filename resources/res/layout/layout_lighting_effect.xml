<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@mipmap/mycar_vecl_pic_operator_seat_board"
    android:layout_width="@dimen/dp_480"
    android:layout_height="@dimen/dp_560">
    <View
        android:background="@mipmap/vecl_pic_model_car"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/view_light_seat"
        android:background="@mipmap/vecl_pic_model_car_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/view_light_front"
        android:background="@mipmap/vecl_pic_lightshow_card_sel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RadioGroup
        android:id="@+id/radio_group_light"
        android:layout_width="@dimen/dp_114"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_110"
        android:layout_marginStart="@dimen/dp_45">
        <RadioButton
            android:textSize="@dimen/sp_24"
            android:textColor="@drawable/btn_vecl_switch_text"
            android:gravity="center"
            android:id="@+id/radio_light_show"
            android:background="@drawable/btn_vecl_switch"
            android:layout_width="@dimen/dp_114"
            android:layout_height="wrap_content"
            android:button="@null"
            android:minHeight="@dimen/dp_44"
            android:text="@string/vecl_light_show"/>
        <RadioButton
            android:textSize="@dimen/sp_24"
            android:textColor="@drawable/btn_vecl_switch_text"
            android:gravity="center"
            android:id="@+id/radio_light_atmosphere"
            android:background="@drawable/btn_vecl_switch"
            android:layout_width="@dimen/dp_114"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_200"
            android:checked="true"
            android:button="@null"
            android:minHeight="@dimen/dp_44"
            android:text="@string/vecl_light_atmosphere"/>
    </RadioGroup>
</RelativeLayout>
