<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/layout_cockpit_0"
    android:layout_width="@dimen/dp_596"
    android:layout_height="@dimen/dp_585">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_car"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_seat_select_left_mirror"
        android:tag="binding_2"
        android:layout_width="@dimen/dp_52"
        android:layout_height="@dimen/dp_52"
        android:layout_marginTop="@dimen/dp_150"
        android:src="@mipmap/pitch_on_left3"
        android:layout_marginStart="@dimen/dp_105"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_seat_select_right_mirror"
        android:tag="binding_3"
        android:layout_width="@dimen/dp_52"
        android:layout_height="@dimen/dp_52"
        android:layout_marginTop="@dimen/dp_150"
        android:src="@mipmap/pitch_on_right3"
        android:layout_marginEnd="@dimen/dp_96"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_seat_select_left"
        android:tag="binding_4"
        android:layout_width="@dimen/dp_95"
        android:layout_height="@dimen/dp_146"
        android:layout_marginTop="@dimen/dp_240"
        android:src="@mipmap/seat_select_bg"
        android:layout_marginStart="@dimen/dp_180"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_seat_select_right"
        android:tag="binding_5"
        android:layout_width="@dimen/dp_95"
        android:layout_height="@dimen/dp_146"
        android:layout_marginTop="@dimen/dp_240"
        android:src="@mipmap/seat_select_bg"
        android:layout_marginEnd="@dimen/dp_180"
        android:layout_alignParentEnd="true"/>
    <RadioButton
        android:textSize="@dimen/sp_28"
        android:textColor="@color/white_transparent90"
        android:gravity="center"
        android:id="@+id/left_rearview_mirror"
        android:tag="binding_6"
        android:background="@drawable/btn_car_window_bg_selector"
        android:layout_width="@dimen/dp_96"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_220"
        android:button="@null"
        android:minHeight="@dimen/dp_96"
        android:text="@string/left_rearview_mirror"
        android:layout_marginStart="@dimen/dp_25"/>
    <RadioButton
        android:textSize="@dimen/sp_28"
        android:textColor="@color/white_transparent90"
        android:gravity="center"
        android:id="@+id/right_rearview_mirror"
        android:tag="binding_7"
        android:background="@drawable/btn_car_window_bg_selector"
        android:layout_width="@dimen/dp_96"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_220"
        android:button="@null"
        android:minHeight="@dimen/dp_96"
        android:text="@string/right_rearview_mirror"
        android:layout_marginEnd="@dimen/dp_25"
        android:layout_alignParentEnd="true"/>
    <RadioButton
        android:textSize="@dimen/sp_30"
        android:textColor="@color/white_transparent90"
        android:gravity="center"
        android:id="@+id/front_left_seat"
        android:tag="binding_8"
        android:background="@drawable/btn_car_window_bg_selector"
        android:layout_width="@dimen/dp_96"
        android:layout_height="@dimen/dp_96"
        android:layout_marginTop="@dimen/dp_82"
        android:button="@null"
        android:layout_below="@+id/left_rearview_mirror"
        android:layout_marginStart="@dimen/dp_180"/>
    <RadioButton
        android:textSize="@dimen/sp_30"
        android:textColor="@color/white_transparent90"
        android:gravity="center"
        android:id="@+id/front_right_seat"
        android:tag="binding_9"
        android:background="@drawable/btn_car_window_bg_selector"
        android:layout_width="@dimen/dp_96"
        android:layout_height="@dimen/dp_96"
        android:button="@null"
        android:layout_alignBottom="@+id/front_left_seat"
        android:layout_marginEnd="@dimen/dp_180"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
