<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/fragment_left_rearview_mirror_0"
    android:background="@color/black"
    android:paddingTop="@dimen/dp_80"
    android:paddingBottom="@dimen/dp_50"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/left_mirror"
        android:background="@mipmap/im_lift_mirror_nor"
        android:layout_width="@dimen/dp_360"
        android:layout_height="@dimen/dp_200"
        android:layout_marginTop="@dimen/dp_155"
        android:layout_marginEnd="@dimen/dp_404"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_up"
        android:background="@drawable/btn_up_selector"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_512"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_down"
        android:background="@drawable/btn_down_selector"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_11"
        android:layout_below="@+id/left_mirror"
        android:layout_alignStart="@+id/move_up"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_left"
        android:background="@drawable/btn_left_selector"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_alignBottom="@+id/move_right"
        android:layout_toStartOf="@+id/left_mirror"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_right"
        android:background="@drawable/btn_right_selector"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_195"
        android:layout_marginEnd="@dimen/dp_260"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_28"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:id="@+id/collapse_all"
        android:background="@drawable/a79_cb_select_yellow_gray90_big"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_62"
        android:text="@string/collapse_all"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/dp_60"
        android:layout_toStartOf="@+id/expand_all"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_28"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:id="@+id/expand_all"
        android:background="@drawable/a79_cb_select_yellow_gray90_big"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_62"
        android:text="@string/expand_all"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/dp_340"
        android:layout_alignParentEnd="true"/>
    <include layout="@layout/tip_gear_not_p"/>
</RelativeLayout>
