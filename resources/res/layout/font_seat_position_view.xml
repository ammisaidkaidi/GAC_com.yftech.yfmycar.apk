<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/seat_position_view"
    android:background="@mipmap/vent_heat_bg"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/seat_adjust_bg_whole"
        android:visibility="visible"
        android:layout_width="@dimen/dp_500"
        android:layout_height="@dimen/dp_500"
        android:layout_marginTop="@dimen/dp_150"
        android:src="@mipmap/vecl_pic_seat_nor_whole"
        android:layout_marginEnd="@dimen/dp_350"
        android:layout_alignParentEnd="true"
        android:elevation="-1dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/backrest_oblique_up"
        android:background="@drawable/btn_oblique_up_selector"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_170"
        android:layout_marginEnd="@dimen/dp_243"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/backrest_oblique_bg"
        android:background="@mipmap/mycar_vecl_pic_seat_bg"
        android:visibility="visible"
        android:layout_width="@dimen/dp_127"
        android:layout_height="@dimen/dp_164"
        android:layout_marginTop="@dimen/dp_243"
        android:layout_marginEnd="@dimen/dp_156"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/backrest_oblique_down"
        android:background="@drawable/btn_oblique_down_selector"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_395"
        android:layout_marginEnd="@dimen/dp_123"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cb_seat_position_point"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_464"
        android:button="@null"
        android:layout_marginEnd="@dimen/dp_567"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/seat_position_move_up"
        android:background="@drawable/btn_up_selector"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginBottom="@dimen/dp_120"
        android:layout_alignBottom="@+id/cb_seat_position_point"
        android:layout_alignStart="@+id/cb_seat_position_point"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/seat_position_move_down"
        android:background="@drawable/btn_down_selector"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_below="@+id/cb_seat_position_point"
        android:layout_alignStart="@+id/cb_seat_position_point"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/seat_position_move_left"
        android:background="@drawable/btn_left_selector"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_alignTop="@+id/cb_seat_position_point"
        android:layout_marginEnd="@dimen/dp_95"
        android:layout_toStartOf="@+id/cb_seat_position_point"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/seat_position_move_right"
        android:background="@drawable/btn_right_selector"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_alignBottom="@+id/cb_seat_position_point"
        android:layout_marginStart="@dimen/dp_215"
        android:layout_alignStart="@+id/cb_seat_position_point"/>
</RelativeLayout>
