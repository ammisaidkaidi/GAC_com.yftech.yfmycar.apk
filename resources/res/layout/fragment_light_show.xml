<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_lightshow_bg"
        android:background="@mipmap/vecl_pic_lightshow_bg_off"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@mipmap/vecl_pic_lightshow_car"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/view_lightshow_car_light"
        android:background="@mipmap/vecl_pic_lightshow_car_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_light_show_inside"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_494"
        android:paddingStart="@dimen/dp_40"
        android:paddingEnd="@dimen/dp_40"
        android:layout_marginStart="@dimen/dp_560"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_28"
            android:textColor="@color/white_70"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vecl_light_atmosphere_tip"
            android:drawablePadding="@dimen/dp_2"
            android:drawableStart="@mipmap/vecl_icon_tips"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_24"
            android:textColor="@color/white_20"
            android:gravity="center"
            android:background="@drawable/btn_atmosphere_open_selector"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_26"
            android:minWidth="@dimen/dp_176"
            android:text="@string/vecl_light_atmosphere_open"
            android:paddingStart="@dimen/dp_5"
            android:paddingEnd="@dimen/dp_5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_light_show_outside"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_494"
        android:layout_marginStart="@dimen/dp_560"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_24"
            android:textColor="@color/white_70"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:text="@string/vecl_light_atmosphere_tip_outside"
            android:drawablePadding="@dimen/dp_2"
            android:drawableStart="@mipmap/vecl_icon_tips"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_gravity="center_horizontal"
            android:id="@+id/ll_atmosphere_style_nor"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_26">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_24"
                android:textColor="@color/white_20"
                android:gravity="center"
                android:background="@drawable/btn_atmosphere_open_nor"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_50"
                android:text="@string/vecl_light_atmosphere_style_rock"
                android:layout_marginEnd="@dimen/dp_34"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_24"
                android:textColor="@color/white_20"
                android:gravity="center"
                android:background="@drawable/btn_atmosphere_open_nor"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_50"
                android:text="@string/vecl_light_atmosphere_style_sky"
                android:layout_marginEnd="@dimen/dp_34"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_24"
                android:textColor="@color/white_20"
                android:gravity="center"
                android:background="@drawable/btn_atmosphere_open_nor"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_50"
                android:text="@string/vecl_light_atmosphere_style_road"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <RadioGroup
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/radio_group_atmosphere_style"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_26"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <RadioButton
                android:textSize="@dimen/sp_24"
                android:textColor="@drawable/btn_vecl_switch_text"
                android:gravity="center"
                android:id="@+id/radio_atmosphere_style_rock"
                android:background="@drawable/btn_atmosphere_style_selector"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_50"
                android:button="@null"
                android:text="@string/vecl_light_atmosphere_style_rock"
                android:layout_marginEnd="@dimen/dp_34"/>
            <RadioButton
                android:textSize="@dimen/sp_24"
                android:textColor="@drawable/btn_vecl_switch_text"
                android:gravity="center"
                android:id="@+id/radio_atmosphere_style_sky"
                android:background="@drawable/btn_atmosphere_style_selector"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_50"
                android:button="@null"
                android:text="@string/vecl_light_atmosphere_style_sky"
                android:layout_marginEnd="@dimen/dp_34"/>
            <RadioButton
                android:textSize="@dimen/sp_24"
                android:textColor="@drawable/btn_vecl_switch_text"
                android:gravity="center"
                android:id="@+id/radio_atmosphere_style_road"
                android:background="@drawable/btn_atmosphere_style_selector"
                android:layout_width="@dimen/dp_176"
                android:layout_height="@dimen/dp_50"
                android:button="@null"
                android:text="@string/vecl_light_atmosphere_style_road"/>
        </RadioGroup>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
