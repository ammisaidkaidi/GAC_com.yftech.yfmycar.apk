<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@mipmap/mycar_vecl_pic_car_skylight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@mipmap/mycar_vecl_pic_sunroof_02_nor"
        android:layout_width="@dimen/dp_150"
        android:layout_height="@dimen/dp_289"
        android:layout_marginTop="@dimen/dp_228"
        android:layout_marginEnd="321dp"
        android:layout_alignParentEnd="true"/>
    <com.yftech.yfmycar.view.widgets.HorizontalAnimWindowTouch
        android:id="@+id/horizontal_anim_window"
        android:layout_width="@dimen/dp_370"
        android:layout_height="@dimen/dp_289"
        android:layout_marginTop="@dimen/dp_228"
        android:layout_marginEnd="@dimen/dp_320"
        android:layout_alignParentEnd="true"
        app:horizontalViewClickable="true"
        app:horizontalViewDrawable="@drawable/sky_light_small_select"
        app:horizontalViewTouchDrawable="@drawable/sky_light_small_select_touch"
        app:horizontalWindowMoveMax="150"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/skylight_til_up"
        android:background="@color/black"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/mycar_vecl_pic_sunroof_01_ventilation"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_32"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/sunroof_moving_tip"
        android:layout_width="650dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_92"
        android:minHeight="@dimen/dp_46"
        android:text="@string/skylight_closed"
        android:layout_marginEnd="@dimen/dp_200"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_left_sky"
        android:background="@drawable/btn_left_selector"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_alignBottom="@+id/move_right_sky"
        android:layout_marginEnd="@dimen/dp_425"
        android:layout_toStartOf="@+id/move_right_sky"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_right_sky"
        android:background="@drawable/btn_right_selector"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_304"
        android:layout_marginEnd="@dimen/dp_188"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:textSize="@dimen/sp_28"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:id="@+id/ventilation"
        android:background="@drawable/a79_cb_select_yellow_gray90_big"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_62"
        android:layout_marginBottom="@dimen/dp_43"
        android:button="@null"
        android:text="@string/ventilation"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="936dp"
        android:layout_alignParentStart="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_28"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:id="@+id/sunshade_fully_open"
        android:background="@drawable/a79_cb_select_yellow_gray90_big"
        android:layout_width="@dimen/sunshade_control_btn_width"
        android:layout_height="@dimen/dp_62"
        android:layout_marginBottom="@dimen/dp_43"
        android:button="@null"
        android:text="@string/sunshade_fully_open"
        android:includeFontPadding="false"
        android:layout_alignParentBottom="true"
        android:lineSpacingExtra="@dimen/sunshade_control_btn_line_spacing"
        android:layout_marginStart="@dimen/dp_120"
        android:layout_toEndOf="@+id/ventilation"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_28"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:id="@+id/sunshade_fully_closed"
        android:background="@drawable/a79_cb_select_yellow_gray90_big"
        android:layout_width="@dimen/sunshade_control_btn_width"
        android:layout_height="@dimen/dp_62"
        android:layout_marginBottom="@dimen/dp_43"
        android:button="@null"
        android:text="@string/sunshade_fully_closed"
        android:includeFontPadding="false"
        android:layout_alignParentBottom="true"
        android:lineSpacingExtra="@dimen/sunshade_control_btn_line_spacing"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_toEndOf="@+id/sunshade_fully_open"/>
    <com.yftech.yfmycar.view.widgets.WindowReversingTipView
        android:id="@+id/windowReversingTipView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
