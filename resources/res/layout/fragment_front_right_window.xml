<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@mipmap/mycar_vecl_pic_car_right_front_car_in"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="-1dp"/>
    <com.yftech.yfmycar.view.widgets.VerticalAnimWindowTouchView
        android:id="@+id/verticalWindow"
        android:layout_width="@dimen/dp_571"
        android:layout_height="@dimen/dp_300"
        android:layout_marginTop="@dimen/dp_304"
        android:layout_marginEnd="350dp"
        android:layout_alignParentEnd="true"
        android:elevation="-1dp"
        app:WhichSeat="1"
        app:WindowMoveMax="250"
        app:backgroundViewDrawable="@drawable/status_front_right_window_selector"
        app:touchViewClickable="true"
        app:touchViewDrawable="@drawable/status_front_right_window_selector_touch"/>
    <View
        android:background="@mipmap/mycar_vecl_pic_car_right_front_car"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:background="@drawable/status_rear_right_window_selector"
        android:layout_width="@dimen/dp_436"
        android:layout_height="@dimen/dp_220"
        android:layout_marginTop="@dimen/dp_302"
        android:layout_marginStart="@dimen/dp_506"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_up_front_right"
        android:background="@drawable/btn_up_selector"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_124"
        android:layout_marginEnd="@dimen/dp_512"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_down_front_right"
        android:background="@drawable/btn_down_selector"
        android:clickable="true"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_120"
        android:layout_marginTop="@dimen/dp_490"
        android:layout_marginEnd="@dimen/dp_512"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_28"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:id="@+id/one_click_open_window_front_right"
        android:background="@drawable/btn_bottom_large_bg_selector"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_62"
        android:layout_marginBottom="@dimen/dp_43"
        android:text="@string/one_click_open_window"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/dp_64"
        android:layout_toStartOf="@+id/one_click_close_window_front_right"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_28"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:id="@+id/one_click_close_window_front_right"
        android:background="@drawable/btn_bottom_large_bg_selector"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_62"
        android:layout_marginBottom="@dimen/dp_43"
        android:text="@string/one_click_close_window"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/dp_340"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
