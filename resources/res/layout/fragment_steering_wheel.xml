<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="@dimen/dp_80"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_up"
        android:background="@drawable/btn_up_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:layout_centerHorizontal="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_down"
        android:background="@drawable/btn_down_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_300"
        android:layout_below="@+id/move_up"
        android:layout_centerHorizontal="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_left"
        android:background="@drawable/btn_left_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="95dp"
        android:layout_below="@+id/move_up"
        android:layout_marginEnd="95dp"
        android:layout_toStartOf="@+id/move_up"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/move_right"
        android:background="@drawable/btn_right_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="95dp"
        android:layout_marginTop="95dp"
        android:layout_toRightOf="@+id/move_up"
        android:layout_below="@+id/move_up"/>
</RelativeLayout>
