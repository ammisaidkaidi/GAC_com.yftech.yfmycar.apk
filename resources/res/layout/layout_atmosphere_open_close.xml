<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="1000dp"
    android:layout_height="match_parent"
    app:divider="@drawable/divider_nor"
    app:showDividers="middle">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_100"
        android:paddingStart="@dimen/dp_70"
        android:paddingEnd="@dimen/dp_70">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_27_5"
            android:textColor="@color/white_90"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:text="@string/vecl_light_atmosphere_inside"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/switcher_atmosphere_open"
            android:background="@drawable/check_switch"
            android:layout_width="@dimen/dp_83"
            android:layout_height="@dimen/dp_38"
            android:button="@null"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_100"
        android:paddingStart="@dimen/dp_70"
        android:paddingEnd="@dimen/dp_36">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_27_5"
            android:textColor="@color/white_90"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:text="@string/vecl_light_atmosphere_brightness"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seekbar_light"
            android:layout_width="468dp"
            android:layout_height="match_parent"
            android:maxHeight="@dimen/dp_12"
            android:max="7"
            android:progress="4"
            android:progressDrawable="@drawable/seek_bar_progress"
            android:thumb="@mipmap/slider_btn_nor"
            android:paddingStart="@dimen/dp_34"
            android:paddingEnd="@dimen/dp_34"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_100"
        android:paddingStart="@dimen/dp_70"
        android:paddingEnd="@dimen/dp_70">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_27_5"
            android:textColor="@color/white_90"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:text="@string/vecl_light_atmosphere_follow_driver_model"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/switcher_atmosphere_follow_car"
            android:background="@drawable/check_switch"
            android:layout_width="@dimen/dp_83"
            android:layout_height="@dimen/dp_38"
            android:button="@null"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_100">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_27_5"
            android:textColor="@color/white_90"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:text="@string/vecl_light_atmosphere_follow_music_model"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp_74"/>
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/switcher_atmosphere_follow_music"
            android:background="@drawable/check_switch"
            android:layout_width="@dimen/dp_83"
            android:layout_height="@dimen/dp_38"
            android:button="@null"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_70"
        android:paddingEnd="@dimen/dp_70">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_27_5"
            android:textColor="@color/white_90"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_46"
            android:layout_marginTop="@dimen/dp_27"
            android:layout_marginBottom="@dimen/dp_2"
            android:text="@string/vecl_light_atmosphere_color"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/seekbar_color"
            android:background="@drawable/seekbar_bg"
            android:layout_width="@dimen/dp_832"
            android:layout_height="wrap_content"
            android:max="31"
            android:progressDrawable="@drawable/seek_bar_progress_colorfull"
            android:thumb="@drawable/seekbar_thumb"
            android:paddingStart="@dimen/dp_33"
            android:paddingEnd="@dimen/dp_33"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
