<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/layout_open_close_control_0"
    android:layout_width="@dimen/dp_596"
    android:layout_height="@dimen/dp_585">
    <View
        android:background="@mipmap/mycar_vecl_pic_operator_seat_board"
        android:layout_width="608dp"
        android:layout_height="596dp"
        android:layout_marginTop="-6dp"
        android:layout_marginStart="-6dp"/>
    <View
        android:id="@+id/img_car_model"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RadioButton
        android:id="@+id/font_window_left"
        android:tag="binding_2"
        android:layout_marginTop="@dimen/dp_177"
        android:text="@string/driver_window"
        android:layout_marginStart="@dimen/dp_38"
        style="@style/openCloseTab"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_font_window_left"
        android:tag="binding_3"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_110"
        android:layout_marginTop="@dimen/dp_166"
        android:src="@mipmap/pitch_on_font_left"
        android:layout_marginStart="@dimen/dp_200"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/font_window_left_point"
        android:tag="binding_4"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_195"
        android:src="@mipmap/mycar_vecl_pic_point"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_toEndOf="@+id/font_window_left"/>
    <RadioButton
        android:id="@+id/font_window_right"
        android:tag="binding_5"
        android:layout_marginTop="@dimen/dp_177"
        android:text="@string/front_right_window"
        android:layout_marginEnd="@dimen/dp_38"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="@dimen/dp_2"
        style="@style/openCloseTab"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_font_window_right"
        android:tag="binding_6"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_110"
        android:layout_marginTop="@dimen/dp_166"
        android:src="@mipmap/pitch_on_font_right"
        android:layout_marginEnd="@dimen/dp_200"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/font_window_right_point"
        android:tag="binding_7"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_195"
        android:src="@mipmap/mycar_vecl_pic_point"
        android:layout_marginEnd="@dimen/dp_20"
        android:layout_toStartOf="@+id/font_window_right"/>
    <RadioButton
        android:id="@+id/rear_window_left"
        android:tag="binding_8"
        android:layout_marginTop="@dimen/dp_60"
        android:text="@string/rear_left_window"
        android:layout_below="@+id/font_window_left"
        android:layout_alignStart="@+id/font_window_left"
        style="@style/openCloseTab"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_rear_window_left"
        android:tag="binding_9"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_107"
        android:layout_marginTop="@dimen/dp_267"
        android:src="@mipmap/pitch_on_rear_left"
        android:layout_marginStart="@dimen/dp_215"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rear_window_left_point"
        android:tag="binding_10"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_90"
        android:src="@mipmap/mycar_vecl_pic_point"
        android:layout_below="@+id/font_window_left_point"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_toEndOf="@+id/font_window_left"/>
    <RadioButton
        android:id="@+id/rear_window_right"
        android:tag="binding_11"
        android:layout_marginTop="@dimen/dp_60"
        android:text="@string/rear_right_window"
        android:layout_below="@+id/font_window_right"
        android:layout_alignEnd="@+id/font_window_right"
        style="@style/openCloseTab"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_rear_window_right"
        android:tag="binding_12"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_107"
        android:layout_marginTop="@dimen/dp_267"
        android:src="@mipmap/pitch_on_rear_right"
        android:layout_marginEnd="@dimen/dp_215"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rear_window_right_point"
        android:tag="binding_13"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_90"
        android:src="@mipmap/mycar_vecl_pic_point"
        android:layout_below="@+id/font_window_right_point"
        android:layout_marginEnd="@dimen/dp_20"
        android:layout_toStartOf="@+id/font_window_right"/>
    <RadioButton
        android:textSize="@dimen/sp_skylight_adjust"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:id="@+id/skylight"
        android:tag="binding_14"
        android:background="@drawable/a79_cb_select_cornor_10_yellow_gray90"
        android:layout_width="@dimen/dp_88"
        android:layout_height="@dimen/dp_108"
        android:layout_marginTop="241dp"
        android:button="@null"
        android:text="@string/skylight"
        android:layout_marginStart="254dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/skylight_point"
        android:tag="binding_15"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="251dp"
        android:src="@mipmap/mycar_vecl_pic_point"
        android:layout_centerHorizontal="true"/>
    <RadioButton
        android:id="@+id/tailgate"
        android:tag="binding_16"
        android:layout_marginTop="@dimen/dp_32"
        android:text="@string/tailgate"
        android:layout_below="@+id/rear_window_right"
        android:layout_alignEnd="@+id/font_window_right"
        style="@style/openCloseTab"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_tailgate"
        android:tag="binding_17"
        android:layout_width="@dimen/dp_127"
        android:layout_height="@dimen/dp_71"
        android:layout_marginTop="377dp"
        android:src="@mipmap/mycar_vecl_pic_window_sel_trunk"
        android:layout_marginEnd="234dp"
        android:layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tailgate_point"
        android:tag="binding_18"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginBottom="130dp"
        android:src="@mipmap/mycar_vecl_pic_point"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_28"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:id="@+id/open_side_window"
        android:tag="binding_19"
        android:background="@drawable/a79_cb_select_yellow_gray90_big"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_62"
        android:layout_marginBottom="@dimen/dp_38"
        android:button="@null"
        android:text="@string/open_side_window"
        android:includeFontPadding="false"
        android:layout_alignParentBottom="true"
        android:lineSpacingExtra="-4dp"
        android:layout_marginStart="@dimen/dp_78"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_28"
        android:textColor="@drawable/btn_text_color_transparent90_selector"
        android:gravity="center"
        android:id="@+id/close_whole_window"
        android:tag="binding_20"
        android:background="@drawable/a79_cb_select_yellow_gray90_big"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_62"
        android:layout_marginBottom="@dimen/dp_38"
        android:button="@null"
        android:text="@string/close_whole_window"
        android:includeFontPadding="false"
        android:layout_alignParentBottom="true"
        android:lineSpacingExtra="-4dp"
        android:layout_marginEnd="@dimen/dp_78"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
